# Server host/port
HOST=127.0.0.1
PORT=5000

# Public application URL used in invitation emails.
APP_URL=https://your-scheduler.example.com

# Supabase server credentials. Never expose the secret/service-role key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Choose one or set both. If both are set, OpenAI is preferred unless a Claude key is sent from UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
